# 复制为 .env 后按需修改。docker compose 直接读取本文件。
# 只有 BOT_QQ 与 NAPCAT_WEBUI_TOKEN 需要改；其余默认值适合本机部署。

# 协议端登录的 QQ 号。start_cortico.sh 会用它生成 onebot11_<QQ>.json。
BOT_QQ=10001

# NapCat WebUI 的登录口令，换成自己的随机串。
NAPCAT_WEBUI_TOKEN=mimi-napcat

# 可换成固定版本，例如 mlikiowa/napcat-docker:v4.18.28。
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest

# 两个容器的运行身份。start_cortico.sh 会用当前用户的 uid/gid 覆盖。
NAPCAT_UID=1000
NAPCAT_GID=1000
MIMI_UID=1000
MIMI_GID=1000

# 只在本机监听。要让局域网访问 WebUI，改成 0.0.0.0 并自行加防火墙。
MIMI_BIND_HOST=127.0.0.1

# 宿主机端口。
CORTICO_PORT=7788
NAPCAT_WEBUI_PORT=6099

TZ=Asia/Shanghai
CORTICO_BOT=mybot
QZONE_BRIDGE_ENABLED=1
